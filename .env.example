# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# ═══ Upstox API (futures + options candles) ═══
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# ═══ Kite Connect (spot + indices) ═══
KITE_API_KEY=
KITE_API_SECRET=
# Written each trading day by:  kite-login --request-token <token>
KITE_ACCESS_TOKEN=

# ═══ ArcticDB store ═══
# Absolute paths. Defaults (if unset) are <repo>/data_cache/arcticdb and
# <repo>/data_cache/arcticdb_spot. Point them at an existing store to reuse its data.
ARCTICDB_DIR=C:\path\to\data_cache\arcticdb
ARCTICDB_SPOT_DIR=C:\path\to\data_cache\arcticdb_spot
DATA_DIR=./data_cache

# ═══ Backtesting defaults ═══
DEFAULT_CAPITAL=1000000
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
RISK_FREE_RATE=0.065

# ═══ Risk defaults ═══
MAX_PORTFOLIO_DRAWDOWN=0.15
MAX_SINGLE_POSITION_PCT=0.05
MAX_PORTFOLIO_DELTA=500
MAX_PORTFOLIO_VEGA=50000

# ═══ Logging ═══
LOG_LEVEL=INFO
LOG_DIR=./logs
